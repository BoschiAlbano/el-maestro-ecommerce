# Plantilla de variables de entorno. Copiar a `.env` y completar con los valores reales
# (Supabase > Project Settings > Database > Connect). Nunca completar este archivo con secretos.
#
# Ojo: el host del pooler (aws-0-, aws-1-, etc.) varía por proyecto — no asumir el número,
# copiar siempre la URI tal cual la muestra el dashboard.

# Prisma: DATABASE_URL es el "Transaction pooler" y lo usa la app en tiempo de ejecución
# via @prisma/adapter-pg (src/lib/prisma.ts).
# DIRECT_URL es la "Direct connection" y la usa Prisma Migrate/introspección
# (prisma7.config.ts). Ver specs/001-base-del-proyecto/plan.md, sección 1.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth / cliente
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Cron de keep-alive de la base (spec 018). Vercel lo envía como "Authorization: Bearer <valor>".
# Generar uno en PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Definirlo también en Vercel (Settings > Environment Variables > Production).
CRON_SECRET="<secreto-aleatorio>"

# Mercado Libre (spec 019). Aplicación registrada en el portal de desarrolladores de
# Mercado Libre. En producción va con la cuenta del cliente; en desarrollo, con la de
# prueba (ver docs/entorno-local.md).
#   - La aplicación necesita el flujo "Refresh Token" y PKCE activados.
#   - ML_REDIRECT_URI tiene que ser https y idéntica a la cargada en la aplicación.
#   - La dirección de avisos de la aplicación es <dominio>/api/mercadolibre/notificaciones
ML_CLIENT_ID="<identificador-de-la-aplicacion>"
ML_CLIENT_SECRET="<clave-secreta-de-la-aplicacion>"
ML_REDIRECT_URI="https://<dominio>/api/mercadolibre/callback"
# 32 bytes en base64, para cifrar la autorización guardada. Generar uno en PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Si se pierde o se cambia, la cuenta conectada hay que volver a conectarla.
ML_TOKEN_ENCRYPTION_KEY="<32-bytes-en-base64>"

# Facturación electrónica (spec 023). Es la única variable: el certificado de ARCA, el CUIT
# y el punto de venta se cargan desde Configuración > Facturación.
# 32 bytes en base64. Cifra la clave privada del certificado y el permiso temporal de ARCA
# guardados en la base. Se genera igual que ML_TOKEN_ENCRYPTION_KEY.
# Si se pierde o se cambia, hay que volver a cargar el certificado.
ARCA_ENCRYPTION_KEY="<32-bytes-en-base64>"

# Solo para desarrollo local (prisma/seed.ts). Nunca en Vercel, nunca con
# prefijo NEXT_PUBLIC_, nunca committeada con un valor real.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SEED_ADMIN_EMAIL="dueno@importadora.local"
SEED_ADMIN_PASSWORD="<elegir una password de desarrollo>"
SEED_ADMIN_NAME="<nombre del Dueño>"
