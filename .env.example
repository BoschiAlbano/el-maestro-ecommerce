# Plantilla de variables de entorno. Copiar a `.env` y completar con los valores reales
# (Supabase > Project Settings > Database > Connect). Nunca completar este archivo con secretos.
#
# Ojo: el host del pooler (aws-0-, aws-1-, etc.) varía por proyecto — no asumir el número,
# copiar siempre la URI tal cual la muestra el dashboard.

# Prisma: DATABASE_URL es el "Transaction pooler" y lo usa la app en tiempo de ejecución
# via @prisma/adapter-pg (src/lib/prisma.ts).
# DIRECT_URL es la "Direct connection" y la usa Prisma Migrate/introspección
# (prisma7.config.ts). Ver specs/001-base-del-proyecto/plan.md, sección 1.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth / cliente
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
