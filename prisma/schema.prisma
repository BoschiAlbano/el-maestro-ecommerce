// Prisma schema del proyecto. Fuente de verdad del esquema de datos
// (ver decisión en specs/001-base-del-proyecto/plan.md, sección 1).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Módulos de negocio que entran en la matriz de permisos por rol.
/// Se agregan a medida que cada módulo tiene su propia spec (ver specs/002, sección 6).
enum ModuloNegocio {
  CATALOGO
  INVENTARIO
  INGRESO_MERCADERIA
  CAJA
  VENTAS
  PEDIDOS
  EMPLEADOS
  ANALITICAS
  CONFIGURACION
}

/// Usuario de la aplicación, vinculado al usuario de Supabase Auth.
model User {
  id              String                @id @default(uuid())
  authUserId      String                @unique
  name            String
  email           String                @unique
  /// Nombre para ingresar al sistema, como lo escribió el dueño (specs/016).
  username        String
  /// Forma normalizada de `username` (minúsculas, sin espacios de más): sobre ella
  /// se busca y se garantiza que sea único sin distinguir mayúsculas.
  usernameKey     String                @unique
  /// Copia del login activo/inactivo de Supabase Auth: un usuario inactivo
  /// no puede iniciar sesión, pero su historial (ventas, caja, etc.) se
  /// conserva con su nombre — nunca se borra el usuario (specs/002, sección 4).
  active          Boolean               @default(true)
  roleId          String
  role            Role                  @relation(fields: [roleId], references: [id])
  auditLogs       AuditLog[]
  priceChanges    ProductPriceHistory[]
  stockMovements  StockMovement[]
  stockEntries    StockEntry[]
  shiftsOpened    CashShift[]           @relation("ShiftsOpened")
  shiftsClosed    CashShift[]           @relation("ShiftsClosed")
  cashMovements   CashMovement[]
  sales           Sale[]
  salesVoided     Sale[]                @relation("SalesVoided")
  ticketReprints  TicketReprint[]
  orders          Order[]
  ordersCancelled Order[]               @relation("OrdersCancelled")
  employee        Employee?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@map("users")
}

/// Rol creado por el dueño, con una matriz de permisos por módulo
/// (RolePermission) y un puñado de permisos especiales (columnas acá,
/// no tabla aparte — son un conjunto fijo y chico, ver plan.md sección 1).
model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  /// true solo en la fila "Dueño". No se borra, no se edita, siempre tiene
  /// todos los permisos (constitución y specs/002, sección 5).
  isOwnerRole Boolean @default(false)

  verCostosMargenes Boolean @default(false)
  anularVentas      Boolean @default(false)
  ajustarStock      Boolean @default(false)
  reimprimirTickets Boolean @default(false)
  cerrarCaja        Boolean @default(false)
  cambiarPrecios    Boolean @default(false)

  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

/// Una fila por combinación rol + módulo: qué puede hacer ese rol en ese módulo.
model RolePermission {
  id       String        @id @default(uuid())
  roleId   String
  role     Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module   ModuloNegocio
  ver      Boolean       @default(false)
  crear    Boolean       @default(false)
  editar   Boolean       @default(false)
  anular   Boolean       @default(false)
  exportar Boolean       @default(false)

  @@unique([roleId, module])
  @@map("role_permissions")
}

/// Datos del negocio y parámetros generales. Fila única (id fijo), no un
/// key-value genérico — son 3 campos conocidos (specs/003, plan.md sección 1).
model Setting {
  id                   String   @id @default("singleton")
  razonSocial          String   @default("")
  textoTicketAdicional String?
  stockMinimoDefault   Int      @default(5)
  /// Productos que estaban bajo el mínimo cuando alguien marcó leído el aviso de
  /// stock bajo (specs/013). El aviso reaparece si queda bajo algún producto que no figure acá.
  stockAlertDismissedIds String[] @default([])
  updatedAt            DateTime @updatedAt

  @@map("settings")
}

/// Acciones que generan una entrada de auditoría. Las specs 006-009 agregan
/// las suyas (anular venta, reimprimir ticket) cuando se construyan — ver
/// specs/003, sección 2. Cambiar precio (spec 004) y ajustar stock
/// (spec 005) NO generan una entrada aparte acá: `ProductPriceHistory` y
/// `StockMovement` ya son en sí mismos el registro de quién/cuándo/por qué,
/// con más detalle del que daría una fila genérica de auditoría.
enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_ACTIVATED
  USER_DEACTIVATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  SYSTEM_RESET
}

/// Registro de auditoría. Solo lectura una vez creado (specs/003, sección 5):
/// no hay ninguna Server Action que edite o borre una fila de esta tabla.
model AuditLog {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation(fields: [userId], references: [id])
  action AuditAction

  /// Referencia a lo afectado (p. ej. "User"/id de usuario). A propósito NO
  /// es una foreign key: si se borra un rol, su auditoría tiene que seguir
  /// existiendo y legible (ver riesgo en plan.md, sección 7).
  targetType String
  targetId   String

  /// Lo que corresponda a cada acción (nombre, rol viejo/nuevo, etc.).
  detail Json?
  /// El "motivo" de la constitución, regla 13. Sin uso en esta spec; lo usan
  /// las acciones de negocio (anular venta, ajuste de stock...).
  reason String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

/// Marca del producto (specs/004). Opcional en `Product` — no todos los
/// productos tienen una marca que valga la pena categorizar.
model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

/// Rubro del producto, con subrubros (relación a sí mismo). `parentId` nulo
/// = rubro de primer nivel; con valor = subrubro. La profundidad de 2
/// niveles se controla en la Server Action, no acá (specs/004, plan.md
/// sección 1).
model Rubro {
  id       String    @id @default(uuid())
  name     String
  parentId String?
  parent   Rubro?    @relation("RubroSubrubros", fields: [parentId], references: [id], onDelete: Restrict)
  children Rubro[]   @relation("RubroSubrubros")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, parentId])
  @@map("rubros")
}

/// Producto del catálogo (specs/004). Sin cantidad de stock — eso es la
/// spec 005, acá `minStock` es solo el umbral de alerta.
model Product {
  id      String  @id @default(uuid())
  name    String
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])
  rubroId String
  rubro   Rubro   @relation(fields: [rubroId], references: [id])

  /// Siempre tiene valor: de origen o generado (ver `barcodeIsGenerated`).
  barcode            String  @unique
  barcodeIsGenerated Boolean @default(false)

  photoUrl String?

  /// `Decimal`, nunca `Float` (constitución, regla 6).
  purchasePrice Decimal @db.Decimal(12, 2)
  salePrice     Decimal @db.Decimal(12, 2)

  minStock Int     @default(5)
  active   Boolean @default(true)

  /// Cacheado: la suma de los `StockMovement` del producto, actualizado
  /// siempre dentro de la misma transacción que crea el movimiento
  /// (`registerStockMovement`, specs/005). Puede quedar en negativo a
  /// propósito (specs/005, sección 5) — sin `@default` que lo impida.
  currentStock Int @default(0)

  priceHistory    ProductPriceHistory[]
  stockMovements  StockMovement[]
  stockEntryItems StockEntryItem[]
  saleItems       SaleItem[]
  orderItems      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

/// Una fila por cada vez que cambió el precio de compra o de venta de un
/// producto (constitución, regla 8: editar un producto no cambia ventas
/// pasadas — este historial es lo que permite reconstruir "cuánto costaba
/// en tal fecha" sin tocar ventas ya hechas).
model ProductPriceHistory {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  purchasePrice Decimal @db.Decimal(12, 2)
  salePrice     Decimal @db.Decimal(12, 2)

  changedByUserId String
  changedByUser   User   @relation(fields: [changedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_price_history")
}

/// INGRESO y VENTA los generan las specs 006 y 008 (todavía no existen);
/// AJUSTE y MERMA los genera esta spec (specs/005). Separados pensando en
/// la spec 011, que va a querer reportar mermas aparte de ajustes comunes.
enum StockMovementType {
  INGRESO
  VENTA
  AJUSTE
  MERMA
}

/// Único camino para cambiar `Product.currentStock` — siempre a través de
/// `registerStockMovement` (specs/005), nunca editando la cantidad directo.
/// Es en sí mismo el registro de auditoría del cambio: no hay una entrada
/// aparte en `AuditLog` para esto (ver el enum `AuditAction`).
model StockMovement {
  id        String            @id @default(uuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType

  /// Con signo: positivo suma, negativo resta. No una cantidad siempre
  /// positiva con un campo de dirección aparte.
  quantity Int

  /// Obligatorio en la Server Action para AJUSTE/MERMA; no para
  /// INGRESO/VENTA, que van a traer su propio contexto (specs 006/008).
  reason String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Solo cuando el origen es una venta (specs/008) — anular una venta
  /// genera un movimiento con este mismo campo, tipo VENTA y cantidad
  /// positiva (signo invertido), para que la suma neta por producto salga
  /// sola sin filtrar anulaciones aparte.
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([saleId])
  @@map("stock_movements")
}

/// Cabecera de una compra de mercadería (specs/006). Sin un campo de fecha
/// de negocio aparte: `createdAt` es "la fecha" del ingreso, igual criterio
/// que `AuditLog`/`ProductPriceHistory`.
model StockEntry {
  id           String  @id @default(uuid())
  supplierName String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items StockEntryItem[]

  createdAt DateTime @default(now())

  @@map("stock_entries")
}

/// Un producto, cantidad y precio pagado dentro de un `StockEntry`.
model StockEntryItem {
  id           String     @id @default(uuid())
  stockEntryId String
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int
  purchasePrice Decimal  @db.Decimal(12, 2)
  /// Opcional: si se cargó, también actualizó `Product.salePrice` al confirmar
  /// el ingreso (specs/006, decisión del 2026-10-16).
  salePrice     Decimal? @db.Decimal(12, 2)

  @@index([stockEntryId])
  @@map("stock_entry_items")
}

/// Solo efectivo y transferencia por ahora (specs/007, sección 5; sin
/// tarjeta ni QR, `docs/PROJECT.md` sección 6).
enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
}

enum CashMovementType {
  INGRESO
  EGRESO
}

/// Un turno de caja. Abierto mientras `closedAt` sea `null`. No se edita ni
/// se borra una vez cerrado (specs/007, sección 5) — una corrección es
/// siempre un `CashMovement` nuevo, en el turno que corresponda.
model CashShift {
  id             String   @id @default(uuid())
  openingAmount  Decimal  @db.Decimal(12, 2)
  openedByUserId String
  openedByUser   User     @relation("ShiftsOpened", fields: [openedByUserId], references: [id])
  openedAt       DateTime @default(now())

  closedAt         DateTime?
  countedCash      Decimal?  @db.Decimal(12, 2)
  difference       Decimal?  @db.Decimal(12, 2)
  differenceReason String?
  closedByUserId   String?
  closedByUser     User?     @relation("ShiftsClosed", fields: [closedByUserId], references: [id])

  movements CashMovement[]
  sales     Sale[]

  @@map("cash_shifts")
}

/// Único lugar donde se registra un pago en todo el sistema (specs/007,
/// sección 2 y 10) — las specs 008/009 crean filas acá para cada forma de
/// pago de una venta o una seña, nunca un monto con dos medios mezclados.
/// `amount` siempre positivo: el signo lo da `type` (ver plan 007, sección 7).
model CashMovement {
  id      String    @id @default(uuid())
  shiftId String
  shift   CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  type    CashMovementType
  amount  Decimal          @db.Decimal(12, 2)
  concept String

  paymentMethod     PaymentMethod
  /// Últimos 4 dígitos del comprobante; obligatorio en la Server Action
  /// cuando `paymentMethod` es TRANSFERENCIA, ausente en efectivo.
  transferReference String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Solo cuando el origen es una venta (specs/008): el ingreso al
  /// cobrarla, o el egreso que la revierte si se anula.
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  /// Solo cuando el origen es la seña de un pedido (specs/009): el
  /// ingreso al cobrarla, o el egreso que la devuelve si se cancela.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([saleId])
  @@index([orderId])
  @@map("cash_movements")
}

/// Una venta de mostrador (specs/008). Anulada si `voidedAt` no es `null`
/// — nunca se borra ni se edita, igual criterio que el resto de la app.
model Sale {
  id           String    @id @default(uuid())
  ticketNumber Int       @unique @default(autoincrement())
  shiftId      String
  shift        CashShift @relation(fields: [shiftId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])

  /// Redondeado al peso con `roundToPeso` (specs/001) — es un monto
  /// calculado, no uno que se carga a mano.
  total Decimal @db.Decimal(12, 2)

  voidedAt       DateTime?
  voidedByUserId String?
  voidedByUser   User?     @relation("SalesVoided", fields: [voidedByUserId], references: [id])
  voidReason     String?

  /// Si esta venta es la entrega de un pedido (specs/009): el pedido de
  /// origen y cuánto de su seña se descontó en esta entrega puntual —
  /// para que el ticket lo muestre sin necesitar una tabla aparte.
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id])
  depositApplied Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  items          SaleItem[]
  reprints       TicketReprint[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]

  @@index([shiftId])
  @@index([orderId])
  @@map("sales")
}

/// Un producto, cantidad y los precios fotografiados en el momento de la
/// venta — `unitCost` nunca se recalcula después (specs/008, sección 5).
model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int
  unitSalePrice Decimal @db.Decimal(12, 2)
  unitCost      Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@map("sale_items")
}

/// Una fila por cada reimpresión real del ticket de una venta — la
/// primera impresión (al confirmar) no cuenta como reimpresión.
model TicketReprint {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([saleId])
  @@map("ticket_reprints")
}

enum OrderStatus {
  PENDIENTE
  CERRADO
  CANCELADO
}

/// Un pedido por encargo (specs/009). La seña es como mucho una por
/// pedido, en un solo pago — vive como campos directos, no una tabla
/// aparte. `depositApplied` es cuánto de esa seña ya se usó en entregas.
model Order {
  id            String      @id @default(uuid())
  customerName  String
  customerPhone String?
  channel       String?
  status        OrderStatus @default(PENDIENTE)
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  depositAmount            Decimal        @default(0) @db.Decimal(12, 2)
  depositPaymentMethod     PaymentMethod?
  depositTransferReference String?
  depositPaidAt            DateTime?
  depositApplied           Decimal        @default(0) @db.Decimal(12, 2)

  closedAt          DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledByUser   User?     @relation("OrdersCancelled", fields: [cancelledByUserId], references: [id])
  cancelReason      String?

  createdAt DateTime @default(now())

  items         OrderItem[]
  sales         Sale[]
  cashMovements CashMovement[]

  @@map("orders")
}

/// Un producto y cantidad de un pedido. Pendiente de esta línea =
/// `quantityOrdered - quantityDelivered`.
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantityOrdered   Int
  quantityDelivered Int @default(0)

  @@index([orderId])
  @@map("order_items")
}

enum Turno {
  MANANA
  TARDE
}

/// Ficha de un empleado (specs/010) — datos propios de RR.HH. encima del
/// `User` (spec 002), 1 a 1. No todo usuario tiene ficha (el Dueño, por
/// ejemplo, no la necesita), pero toda ficha tiene un usuario.
model Employee {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  dni          String    @unique
  phone        String?
  hireDate     DateTime
  shift        Turno
  terminatedAt DateTime?

  createdAt DateTime @default(now())

  @@map("employees")
}

enum NotificationType {
  PEDIDO_NUEVO
  DIFERENCIA_CAJA
}

/// Aviso puntual (specs/013) — solo pedido nuevo y diferencia de caja; el
/// de stock bajo no se persiste, se calcula en vivo (ver `loadTravelList`,
/// specs/012). `readAt` es global, no por usuario (equipo chico, una sola
/// caja). Sin FK a lo que originó el aviso a propósito (mismo criterio que
/// `AuditLog`, specs/003): si se borra lo referenciado, el aviso sigue
/// pudiendo mostrarse.
model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  message    String
  targetType String
  targetId   String

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([readAt])
  @@map("notifications")
}
