// Prisma schema del proyecto. Fuente de verdad del esquema de datos
// (ver decisión en specs/001-base-del-proyecto/plan.md, sección 1).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Módulos de negocio que entran en la matriz de permisos por rol.
/// Se agregan a medida que cada módulo tiene su propia spec (ver specs/002, sección 6).
enum ModuloNegocio {
  CATALOGO
  INVENTARIO
  INGRESO_MERCADERIA
  CAJA
  VENTAS
  PEDIDOS
  EMPLEADOS
  ANALITICAS
  CONFIGURACION
}

/// Usuario de la aplicación, vinculado al usuario de Supabase Auth.
model User {
  id         String   @id @default(uuid())
  authUserId String   @unique
  name       String
  email      String   @unique
  /// Copia del login activo/inactivo de Supabase Auth: un usuario inactivo
  /// no puede iniciar sesión, pero su historial (ventas, caja, etc.) se
  /// conserva con su nombre — nunca se borra el usuario (specs/002, sección 4).
  active     Boolean  @default(true)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  auditLogs  AuditLog[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}

/// Rol creado por el dueño, con una matriz de permisos por módulo
/// (RolePermission) y un puñado de permisos especiales (columnas acá,
/// no tabla aparte — son un conjunto fijo y chico, ver plan.md sección 1).
model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  /// true solo en la fila "Dueño". No se borra, no se edita, siempre tiene
  /// todos los permisos (constitución y specs/002, sección 5).
  isOwnerRole Boolean @default(false)

  verCostosMargenes Boolean @default(false)
  anularVentas      Boolean @default(false)
  ajustarStock      Boolean @default(false)
  reimprimirTickets Boolean @default(false)
  cerrarCaja        Boolean @default(false)
  cambiarPrecios    Boolean @default(false)

  users       User[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

/// Una fila por combinación rol + módulo: qué puede hacer ese rol en ese módulo.
model RolePermission {
  id       String        @id @default(uuid())
  roleId   String
  role     Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module   ModuloNegocio
  ver      Boolean       @default(false)
  crear    Boolean       @default(false)
  editar   Boolean       @default(false)
  anular   Boolean       @default(false)
  exportar Boolean       @default(false)

  @@unique([roleId, module])
  @@map("role_permissions")
}

/// Datos del negocio y parámetros generales. Fila única (id fijo), no un
/// key-value genérico — son 3 campos conocidos (specs/003, plan.md sección 1).
model Setting {
  id                   String  @id @default("singleton")
  razonSocial          String  @default("")
  textoTicketAdicional String?
  stockMinimoDefault   Int     @default(5)
  updatedAt            DateTime @updatedAt

  @@map("settings")
}

/// Acciones que generan una entrada de auditoría. Las specs 005-009 agregan
/// las suyas (anular venta, ajustar stock, reimprimir ticket, cambiar precio)
/// cuando se construyan — ver specs/003, sección 2.
enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_ACTIVATED
  USER_DEACTIVATED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
}

/// Registro de auditoría. Solo lectura una vez creado (specs/003, sección 5):
/// no hay ninguna Server Action que edite o borre una fila de esta tabla.
model AuditLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  action AuditAction

  /// Referencia a lo afectado (p. ej. "User"/id de usuario). A propósito NO
  /// es una foreign key: si se borra un rol, su auditoría tiene que seguir
  /// existiendo y legible (ver riesgo en plan.md, sección 7).
  targetType String
  targetId   String

  /// Lo que corresponda a cada acción (nombre, rol viejo/nuevo, etc.).
  detail Json?
  /// El "motivo" de la constitución, regla 13. Sin uso en esta spec; lo usan
  /// las acciones de negocio (anular venta, ajuste de stock...).
  reason String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}
